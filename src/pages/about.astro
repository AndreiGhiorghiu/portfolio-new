</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-about-link]");

  if (links.length > 0) {
    const sections = [...links]
      .map((link) => document.getElementById(link.dataset.aboutLink ?? ""))
      .filter((el): el is HTMLElement => el !== null);

    const pick = () => {
      // #beyond-code sits in the side rail, so position-based tracking would
      // fire too early — highlight it only at the bottom of the page instead
      const atBottom =
        window.innerHeight + window.scrollY >= document.body.scrollHeight - 40;

      let current = sections[0]?.id ?? "";
      for (const section of sections) {
        if (section.id === "beyond-code") continue;
        if (section.getBoundingClientRect().top <= 120) current = section.id;
      }
      if (atBottom) current = "beyond-code";

      links.forEach((link) =>
        link.classList.toggle("active", link.dataset.aboutLink === current),
      );
    };

    document.addEventListener("scroll", pick, { passive: true });
    pick();
  }
</script>
