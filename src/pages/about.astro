---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";
import MobileDrawer from "../components/MobileDrawer.astro";
import QuoteCard from "../components/QuoteCard.astro";
import Icon from "../components/Icon.astro";

const tocItems = [
  { id: "overview", title: "Overview", icon: "target" },
  { id: "experience", title: "Experience", icon: "layout" },
  { id: "skills", title: "Skills & Strengths", icon: "cube" },
  { id: "philosophy", title: "Philosophy", icon: "eye" },
  { id: "timeline", title: "Timeline", icon: "chart" },
  { id: "beyond-code", title: "Beyond Code", icon: "globe" },
];

// Source of truth: the CV (2025)
const experience = [
  {
    years: "2026 — Present",
    role: "JavaScript Developer",
    company: "Veikkaus · Contract",
    text: "Contract work on high-traffic gaming platforms for Finland's national gaming company — building features with a focus on scalability, performance and developer experience.",
    tags: ["TypeScript", "React", "Node.js"],
  },
  {
    years: "2025 — 2026",
    role: "Full-Stack Engineer",
    company: "SmartIBAN · Contract",
    text: "Modernized applications and delivered scalable solutions. Helped integrate a unified design system across apps; Agile and TDD, with security and networking know-how applied to real performance problems.",
    tags: ["Vue.js", "Node.js", "PrimeVue", "MySQL"],
  },
  {
    years: "2020 — 2025",
    role: "Full-Stack Developer · Technical Lead",
    company: "Tremend by Publicis Sapient",
    text: "Led projects for 20+ major clients (Vodafone, ASDA, Altex), delivering 70+ full-stack features and 10+ releases. Drove React adoption (+40% UI performance), a full TypeScript migration (−25% runtime errors), CI/CD pipelines, and mentored 20+ developers.",
    tags: ["TypeScript", "React", "Next.js", "AWS", "Docker"],
  },
  {
    years: "2018 — 2019",
    role: "Software Developer",
    company: "Evonomix",
    text: "Built the Flaminjoy marketing platform with Laravel and Vue.js — Instagram and Facebook API integrations, frontend components from design, efficient frontend–backend collaboration.",
    tags: ["Laravel", "Vue.js", "Social APIs"],
  },
  {
    years: "2017 — Present",
    role: "Full-Stack Developer",
    company: "Freelance",
    text: "Tailored web, desktop and mobile applications: real-time apps with WebSockets, video and photo editing tools with FFMPEG and Sharp, CMS platforms for real estate and healthcare — across Electron, React Native, Expo and Capacitor.",
    tags: ["React", "Electron", "React Native", "Node.js"],
  },
  {
    years: "2015 — 2018",
    role: "Web Specialist",
    company: "Akson",
    text: "Custom e-commerce for 5+ clients: 10+ WordPress and WooCommerce plugins, payment gateways (Stripe, PayU, Mobilpay), shipping integrations, and Craft CMS builds — plus mentoring 3+ junior developers.",
    tags: ["PHP", "WordPress", "WooCommerce", "Vue"],
  },
];

const skills = [
  {
    icon: "cube",
    title: "System Design",
    text: "Designing scalable, resilient and maintainable architectures.",
  },
  {
    icon: "code",
    title: "Full-Stack Expertise",
    text: "End-to-end development across web, mobile and desktop.",
  },
  {
    icon: "chart",
    title: "Performance Focused",
    text: "Measured wins: +40% UI performance, proactive bottleneck hunting.",
  },
  {
    icon: "shield-check",
    title: "Mentorship & Leadership",
    text: "20+ developers mentored through reviews, pairing and docs.",
  },
];

const timeline = [
  { year: "2015", text: "First dev job\nAkson" },
  { year: "2017", text: "Freelancing\nbegins" },
  { year: "2018", text: "CS degree ·\nEvonomix" },
  { year: "2020", text: "Tremend by\nPublicis Sapient" },
  { year: "2025", text: "SmartIBAN\nContract" },
  { year: "2026", text: "Veikkaus ·\nStill shipping" },
];

const quickFacts = [
  { icon: "target", key: "Name", value: "Andrei Ghiorghiu" },
  { icon: "globe", key: "Location", value: "Bucharest, Romania" },
  { icon: "chart", key: "Timezone", value: "UTC+2" },
  { icon: "terminal", key: "Email", value: "andreighiorghiudev@gmail.com" },
  { icon: "book", key: "Languages", value: "RO / EN" },
];

const stats = [
  { value: "9+", label: "Years of experience" },
  { value: "20+", label: "Major clients served" },
  { value: "70+", label: "Full-stack features shipped" },
  { value: "20+", label: "Developers mentored" },
];

const beyondCode = [
  {
    icon: "globe",
    title: "Time in Nature",
    text: "Hiking and unplugging — clarity comes from outside the terminal.",
  },
  {
    icon: "book",
    title: "Continuous Learning",
    text: "Always reading about new technologies. Always building.",
  },
  {
    icon: "shield-check",
    title: "Family First",
    text: "The best system I maintain runs at home.",
  },
  {
    icon: "zap",
    title: "Competitive Roots",
    text: "1st place, Ovidius University CS competition (2013).",
  },
];
---

<Base
  title="About Me"
  description="Andrei Ghiorghiu — Full-Stack Architect and developer with 9+ years of experience building scalable web, mobile and desktop applications."
>
  <Header />

  <div class="about-shell">
    <div class="left-col">
      <nav class="toc panel" aria-label="On this page">
        <p class="panel-title label">On This Page</p>
        <ul>
          {
            tocItems.map((item, index) => (
              <li>
                <a
                  href={`#${item.id}`}
                  class:list={["toc-link", { active: index === 0 }]}
                  data-about-link={item.id}
                >
                  <Icon name={item.icon} size={13} />
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="terminal-card">
        <div class="chrome" aria-hidden="true">
          <span class="dots"><i></i><i></i><i></i></span>
          <Icon name="expand" size={12} class="expand" />
        </div>
        <div class="terminal-body">
          <p><span class="ps">&gt;</span> whoami</p>
          <p class="out accent">andreighiorghiu</p>
          <p class="gap"><span class="ps">&gt;</span> cat role.txt</p>
          <p class="out">Full-Stack Architect</p>
          <p class="out">Problem Solver</p>
          <p class="out">System Designer</p>
          <p class="gap"><span class="ps">&gt;</span> cat location.txt</p>
          <p class="out">Bucharest, Romania</p>
          <p class="out">UTC+2</p>
          <p class="gap"><span class="ps">&gt;</span> cat status.txt</p>
          <p class="out">Building · Learning · Sharing</p>
          <p class="out">Always shipping</p>
          <p class="gap"><span class="ps">&gt;</span> <span class="block-cursor"></span></p>
        </div>
      </div>

      <QuoteCard
        quote="Code is my medium. Architecture is my craft. Impact is the goal."
        author="Andrei Ghiorghiu"
      />
    </div>

    <main>
      <section id="overview" class="about-section">
        <p class="page-label label">/ About</p>
        <div class="intro-row">
          <div class="intro-text">
            <h1 class="cursor">About Me</h1>
            <p class="lead">
              I'm a Full-Stack Architect and developer with 9+ years of
              experience building scalable, performative and maintainable
              systems.
              <br />
              I bridge the gap between business goals and technical solutions.
              <br />
              I design architecture. I write code. I ship value.
            </p>
            <div class="cta-row">
              <a href="mailto:andreighiorghiudev@gmail.com" class="btn primary label">
                Let's Work Together <Icon name="arrow-right" size={14} />
              </a>
              <a href="/Andrei-Ghiorghiu-CV.pdf" download class="btn ghost label">
                Download CV <Icon name="arrow-down" size={14} />
              </a>
            </div>
          </div>
          <img
            class="portrait"
            src="/images/andrei-portrait.jpg"
            alt="Portrait of Andrei Ghiorghiu"
            width="300"
            height="378"
            loading="eager"
          />
        </div>
      </section>

      <section id="experience" class="about-section">
        <h2 class="section-title label">// Experience</h2>
        <div class="xp-list panel">
          {
            experience.map((job) => (
              <article class="xp">
                <div class="xp-when">
                  <span class="xp-dot" aria-hidden="true"></span>
                  <span class="xp-years">{job.years}</span>
                </div>
                <div class="xp-body">
                  <h3>{job.role}</h3>
                  <p class="xp-company">{job.company}</p>
                  <p class="xp-text">{job.text}</p>
                </div>
                <ul class="xp-tags" role="list">
                  {job.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section id="skills" class="about-section">
        <h2 class="section-title label">// Skills &amp; Strengths</h2>
        <div class="skills-grid">
          {
            skills.map((skill) => (
              <article class="skill-card">
                <span class="skill-icon">
                  <Icon name={skill.icon} size={22} />
                </span>
                <h3>{skill.title}</h3>
                <p>{skill.text}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="philosophy" class="about-section">
        <h2 class="section-title label">// Philosophy</h2>
        <div class="philosophy panel">
          <p><span class="ps">&gt;</span> Simplicity scales. Complexity is a loan with interest.</p>
          <p><span class="ps">&gt;</span> The best architecture is the one the next developer understands.</p>
          <p><span class="ps">&gt;</span> Ship, measure, refine — value beats perfection.</p>
          <p><span class="ps">&gt;</span> Knowledge grows when it's shared. Mentor, document, repeat.</p>
        </div>
      </section>

      <section id="timeline" class="about-section">
        <h2 class="section-title label">// Timeline</h2>
        <div class="timeline">
          <div class="tl-track" aria-hidden="true"></div>
          {
            timeline.map((point) => (
              <div class="tl-point">
                <span class="tl-dot" aria-hidden="true"></span>
                <span class="tl-year">{point.year}</span>
                <span class="tl-text">{point.text}</span>
              </div>
            ))
          }
        </div>
      </section>
    </main>

    <div class="rail-col">
      <div class="panel rail-panel">
        <p class="panel-title label">// Quick Facts</p>
        <ul class="facts">
          {
            quickFacts.map((fact) => (
              <li>
                <span class="fact-icon">
                  <Icon name={fact.icon} size={14} />
                </span>
                <div>
                  <p class="fact-key">{fact.key}</p>
                  <p class="fact-value">{fact.value}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="panel rail-panel">
        <p class="panel-title label">// Stats</p>
        <ul class="stats">
          {
            stats.map((stat) => (
              <li>
                <span class="stat-value">{stat.value}</span>
                <span class="stat-label">{stat.label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="panel rail-panel" id="beyond-code">
        <p class="panel-title label">// Beyond Code</p>
        <ul class="beyond">
          {
            beyondCode.map((item) => (
              <li>
                <span class="fact-icon">
                  <Icon name={item.icon} size={14} />
                </span>
                <div>
                  <p class="fact-key strong">{item.title}</p>
                  <p class="fact-value dim">{item.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <Footer />
  <SearchModal />
  <MobileDrawer />
</Base>

<style>
  .about-shell {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr) 300px;
    gap: var(--space-4);
    align-items: start;
    max-width: 1560px;
    margin: 0 auto;
    padding: var(--space-4);
    min-height: calc(100vh - var(--header-h));
  }

  .left-col {
    position: sticky;
    top: calc(var(--header-h) + var(--space-4));
    max-height: calc(100vh - var(--header-h) - var(--space-4) * 2);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .rail-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .panel-title {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--green);
    margin-bottom: var(--space-3);
  }

  /* ── left column ───────────────────────────────────── */
  .toc {
    padding: var(--space-3);
  }

  .toc .panel-title {
    color: var(--text);
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    font-size: var(--fs-sm);
    color: var(--text-dim);
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .toc-link:hover {
    color: var(--text);
    background: var(--bg-hover);
  }

  .toc-link.active {
    color: var(--green);
    background: var(--bg-active);
    border-left-color: var(--green);
  }

  .terminal-card {
    border: var(--border-dim);
    border-radius: var(--radius-lg);
    background: var(--bg-panel);
    overflow: hidden;
  }

  .chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-bottom: var(--border-dim);
  }

  .dots {
    display: flex;
    gap: 5px;
  }

  .dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-faint);
  }

  .dots i:first-child {
    background: rgba(74, 222, 80, 0.6);
  }

  .chrome :global(.expand) {
    color: var(--text-faint);
  }

  .terminal-body {
    padding: var(--space-3);
    font-size: var(--fs-xs);
    line-height: 1.9;
  }

  .terminal-body p {
    margin: 0;
    color: var(--text);
  }

  .terminal-body .gap {
    margin-top: 10px;
  }

  .ps {
    color: var(--green);
    font-weight: 700;
  }

  .out {
    color: var(--text-dim);
    padding-left: 14px;
  }

  .out.accent {
    color: var(--green);
  }

  .block-cursor {
    display: inline-block;
    width: 8px;
    height: 13px;
    background: var(--green);
    vertical-align: middle;
    animation: blink 1.1s steps(1) infinite;
  }

  /* ── overview ──────────────────────────────────────── */
  .page-label {
    color: var(--green);
    margin-bottom: var(--space-3);
  }

  .about-section {
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .about-section + .about-section {
    margin-top: var(--space-5);
  }

  .intro-row {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    justify-content: space-between;
  }

  h1 {
    font-size: var(--fs-h1);
    margin-bottom: var(--space-3);
  }

  .lead {
    color: var(--text-dim);
    font-size: var(--fs-md);
    line-height: 1.9;
    max-width: 58ch;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 22px;
    border-radius: var(--radius);
    font-weight: 700;
  }

  .btn.primary {
    background: var(--green);
    color: #04220a;
    box-shadow: var(--glow-strong);
  }

  .btn.primary:hover {
    background: var(--green-bright);
  }

  .btn.ghost {
    border: var(--border);
    color: var(--green);
    background: rgba(74, 222, 80, 0.04);
  }

  .btn.ghost:hover {
    border-color: var(--green);
    box-shadow: var(--glow);
  }

  .portrait {
    width: min(300px, 38%);
    height: auto;
    flex-shrink: 0;
    clip-path: polygon(
      28px 0,
      calc(100% - 28px) 0,
      100% 28px,
      100% calc(100% - 28px),
      calc(100% - 28px) 100%,
      28px 100%,
      0 calc(100% - 28px),
      0 28px
    );
  }

  /* ── experience ────────────────────────────────────── */
  .section-title {
    color: var(--green);
    font-size: var(--fs-sm);
    margin-bottom: var(--space-3);
  }

  .xp-list {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: relative;
  }

  .xp {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: start;
  }

  .xp-when {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .xp-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px rgba(74, 222, 80, 0.6);
    flex-shrink: 0;
    transform: translateY(1px);
  }

  .xp:not(:first-child) .xp-dot {
    background: var(--green-dim);
    box-shadow: none;
  }

  .xp-years {
    font-size: var(--fs-xs);
    color: var(--text-dim);
    white-space: nowrap;
  }

  .xp-body h3 {
    font-size: var(--fs-base);
    color: var(--text-bright);
  }

  .xp-company {
    color: var(--green);
    font-size: var(--fs-sm);
    margin: 2px 0 8px;
  }

  .xp-text {
    color: var(--text-dim);
    font-size: var(--fs-sm);
    line-height: 1.7;
    margin: 0;
    max-width: 62ch;
  }

  .xp-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 180px;
    justify-content: flex-end;
  }

  .xp-tags li {
    font-size: var(--fs-2xs);
    color: var(--text);
    border: var(--border-dim);
    border-radius: var(--radius);
    background: var(--bg-panel-2);
    padding: 3px 9px;
    white-space: nowrap;
  }

  /* ── skills ────────────────────────────────────────── */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .skill-card {
    border: var(--border-dim);
    border-radius: var(--radius-lg);
    background: var(--bg-panel);
    padding: var(--space-4) var(--space-3);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .skill-card:hover {
    border-color: var(--border-c);
    box-shadow: var(--glow);
  }

  .skill-icon {
    display: flex;
    color: var(--green);
    margin-bottom: var(--space-3);
  }

  .skill-card h3 {
    font-size: var(--fs-sm);
    color: var(--text-bright);
    margin-bottom: var(--space-2);
  }

  .skill-card p {
    color: var(--text-dim);
    font-size: var(--fs-xs);
    line-height: 1.6;
    margin: 0;
  }

  /* ── philosophy ────────────────────────────────────── */
  .philosophy {
    padding: var(--space-4);
  }

  .philosophy p {
    margin: 0;
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 2.1;
  }

  /* ── timeline ──────────────────────────────────────── */
  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-2);
    padding-top: 4px;
  }

  .tl-track {
    position: absolute;
    top: 8px;
    left: 8%;
    right: 8%;
    height: 1px;
    background: var(--border-c);
  }

  .tl-point {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    position: relative;
  }

  .tl-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px rgba(74, 222, 80, 0.6);
  }

  .tl-year {
    color: var(--green);
    font-size: var(--fs-xs);
    font-weight: 700;
  }

  .tl-text {
    color: var(--text-dim);
    font-size: var(--fs-2xs);
    line-height: 1.6;
    white-space: pre-line;
  }

  /* ── right rail ────────────────────────────────────── */
  .rail-panel {
    padding: var(--space-3);
  }

  .facts,
  .beyond,
  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .facts li,
  .beyond li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .fact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: var(--green);
    border: var(--border-dim);
    border-radius: 50%;
    background: var(--bg-active);
  }

  .fact-key {
    color: var(--text-dim);
    font-size: var(--fs-2xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
    margin: 0;
  }

  .fact-key.strong {
    color: var(--text);
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .fact-value {
    color: var(--text);
    font-size: var(--fs-sm);
    margin: 2px 0 0;
    overflow-wrap: anywhere;
  }

  .fact-value.dim {
    color: var(--text-dim);
    font-size: var(--fs-xs);
  }

  .stats li {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .stat-value {
    color: var(--green);
    font-size: 1.35rem;
    font-weight: 800;
    min-width: 58px;
    text-shadow: 0 0 10px rgba(74, 222, 80, 0.35);
  }

  .stat-label {
    color: var(--text-dim);
    font-size: var(--fs-xs);
  }

  /* ── responsive ────────────────────────────────────── */
  @media (max-width: 1279px) {
    .about-shell {
      grid-template-columns: 232px minmax(0, 1fr);
    }

    .rail-col {
      grid-column: 1 / -1;
      display: grid;
