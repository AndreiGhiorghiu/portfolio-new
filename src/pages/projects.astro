---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";
import MobileDrawer from "../components/MobileDrawer.astro";
import Icon from "../components/Icon.astro";
import TechIcon from "../components/TechIcon.astro";
import ProjectThumb from "../components/ProjectThumb.astro";
import { projects, filters } from "../lib/projects";

const updated = new Date()
  .toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" })
  .toUpperCase();
---

<Base
  title="Selected Projects"
  description="Projects Andrei Ghiorghiu has architected and built — full-stack platforms, 3D experiences and client work, crafted with scalability and developer experience in mind."
>
  <Header />

  <div class="projects-shell">
    <div class="intro-row">
      <div class="intro-text">
        <p class="page-label label">/ Projects</p>
        <h1 class="cursor">Selected Projects</h1>
        <p class="lead">
          A collection of projects I've architected and built. Each one is a
          solution to a real-world problem, crafted with scalability,
          performance and developer experience in mind.
        </p>
      </div>
      <aside class="callout">
        <p><span class="chev">&gt;</span> echo "Building solutions that scale."</p>
        <p><span class="chev">&gt;</span> ls /projects | cat</p>
      </aside>
    </div>

    <div class="toolbar">
      <div class="filters" role="group" aria-label="Filter projects">
        {
          filters.map((filter, index) => (
            <button
              class:list={["filter-chip", "label", { active: index === 0 }]}
              data-filter={filter.key}
            >
              {filter.label}
            </button>
          ))
        }
      </div>
      <label class="project-search">
        <Icon name="search" size={15} />
        <input type="text" id="project-search" placeholder="Search projects..." />
      </label>
    </div>

    <div class="grid" id="project-grid">
      {
        projects.map((project) => (
          <article
            class="card"
            data-cats={project.categories.join(" ")}
            data-text={`${project.title} ${project.description} ${project.tags
              .map((tag) => tag.label)
              .join(" ")}`.toLowerCase()}
          >
            <div class="thumb-wrap">
              <ProjectThumb variant={project.thumb} />
              {project.featured && <span class="featured label">Featured</span>}
              <span class="year label">
                <i /> {project.year}
              </span>
            </div>
            <div class="card-body">
              <h2>{project.title}</h2>
              <p class="desc">{project.description}</p>
              <ul class="tags" role="list">
                {project.tags.map((tag) => (
                  <li>
                    <TechIcon name={tag.icon} size={18} />
                    {tag.label}
                  </li>
                ))}
              </ul>
              <div class="card-links">
                {project.live && (
                  <a href={project.live} class="card-link label" target="_blank" rel="noopener">
                    View Live <Icon name="arrow-right" size={13} />
                  </a>
                )}
                {project.caseStudy && (
                  <a href={project.caseStudy} class="card-link label">
                    View Case Study <Icon name="arrow-right" size={13} />
                  </a>
                )}
                {project.code && (
                  <a href={project.code} class="card-link label" target="_blank" rel="noopener">
                    View Code <Icon name="arrow-right" size={13} />
                  </a>
                )}
                {!project.live && !project.caseStudy && !project.code && project.note && (
                  <span class="private label">// {project.note}</span>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="no-results label" id="no-results" hidden>
      &gt; no projects matched your query_
    </p>

    <div class="bottom-row">
      <div class="status-box">
        <p><span class="chev">&gt;</span> STATUS: <b class="ok">ONLINE</b></p>
        <p><span class="chev">&gt;</span> UPDATED: <b>{updated}</b></p>
        <p><span class="chev">&gt;</span> TOTAL PROJECTS: <b>{projects.length}</b></p>
      </div>
      <div class="cta-box">
        <p class="cta-title">Interested in working together?</p>
        <p class="cta-sub">let's build something great.</p>
        <a href="/contact/" class="cta-link label">
          Contact Me <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </div>

  <Footer />
  <SearchModal />
  <MobileDrawer />
</Base>

<style>
  .projects-shell {
    max-width: 1360px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
    min-height: calc(100vh - var(--header-h));
  }

  .page-label {
    color: var(--green);
    margin-bottom: var(--space-3);
  }

  .intro-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: var(--fs-h1);
    margin-bottom: var(--space-3);
  }

  .lead {
    color: var(--text-dim);
    font-size: var(--fs-md);
    line-height: 1.8;
    max-width: 58ch;
  }

  .callout {
    flex-shrink: 0;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--bg-active);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
    color: var(--green);
    box-shadow: var(--glow);
  }

  .callout p {
    margin: 0;
    line-height: 1.9;
  }

  .chev {
    font-weight: 700;
  }

  /* ── toolbar ───────────────────────────────────────── */
  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .filter-chip {
    padding: 9px 16px;
    border: var(--border-dim);
    border-radius: var(--radius);
    color: var(--text-dim);
    background: var(--bg-panel);
  }

  .filter-chip:hover {
    color: var(--text);
    border-color: var(--border-c);
  }

  .filter-chip.active {
    color: var(--green);
    border-color: var(--green);
    background: var(--bg-active);
    box-shadow: var(--glow);
  }

  .project-search {
    display: flex;
    align-items: center;
    gap: 10px;
    border: var(--border-dim);
    border-radius: var(--radius);
    background: var(--bg-panel);
    padding: 9px 14px;
    color: var(--text-dim);
    min-width: 240px;
  }

  .project-search:focus-within {
    border-color: var(--green);
    box-shadow: var(--glow);
  }

  .project-search input {
    background: none;
    border: none;
    outline: none;
    color: var(--text-bright);
    font-family: var(--font);
    font-size: var(--fs-sm);
    width: 100%;
  }

  .project-search input::placeholder {
    color: var(--text-faint);
  }

  /* ── grid & cards ──────────────────────────────────── */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .card {
    display: flex;
    flex-direction: column;
    border: var(--border-dim);
    border-radius: var(--radius-lg);
    background: var(--bg-panel);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    border-color: var(--border-c);
    box-shadow: var(--glow);
    transform: translateY(-2px);
  }

  .card[hidden] {
    display: none;
  }

  .thumb-wrap {
    position: relative;
  }

  .featured {
    position: absolute;
    top: 12px;
    left: 12px;
    color: var(--bg);
    background: var(--green);
    border-radius: var(--radius);
    padding: 3px 10px;
    font-weight: 700;
  }

  .year {
    position: absolute;
    top: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text);
  }

  .year i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 6px rgba(74, 222, 80, 0.7);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: var(--space-3) var(--space-4) var(--space-4);
    flex: 1;
  }

  h2 {
    font-size: var(--fs-lg);
    color: var(--text-bright);
  }

  .desc {
    color: var(--text-dim);
    font-size: var(--fs-sm);
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tags li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: var(--fs-2xs);
    color: var(--text);
    border: var(--border-dim);
    border-radius: var(--radius);
    background: var(--bg-panel-2);
    padding: 4px 10px 4px 5px;
  }

  .card-links {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    border-top: var(--border-dim);
    padding-top: 14px;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--green);
  }

  .card-link:hover {
    color: var(--green-bright);
  }

  .private {
    color: var(--text-faint);
  }

  .no-results {
    color: var(--text-dim);
    text-align: center;
    padding: var(--space-5) 0;
  }

  /* ── bottom row ────────────────────────────────────── */
  .bottom-row {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .status-box {
    border: var(--border);
    border-radius: var(--radius);
    background: var(--bg-panel);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-xs);
    letter-spacing: 0.05em;
    box-shadow: var(--glow);
  }

  .status-box p {
    margin: 0;
    color: var(--text-dim);
    line-height: 1.9;
    text-transform: uppercase;
  }

  .status-box b {
    color: var(--text);
    font-weight: 600;
  }

  .status-box .ok {
    color: var(--green);
  }

  .cta-box {
    border: var(--border);
    border-radius: var(--radius);
    background: var(--bg-active);
    padding: var(--space-3) var(--space-4);
    box-shadow: var(--glow);
  }

  .cta-title {
    color: var(--green);
    font-size: var(--fs-sm);
    font-weight: 700;
    margin: 0;
  }

  .cta-sub {
    color: var(--text-dim);
    font-size: var(--fs-sm);
    margin: 2px 0 10px;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--green);
    font-weight: 700;
  }

  .cta-link:hover {
    color: var(--green-bright);
  }

  /* ── responsive ────────────────────────────────────── */
  @media (max-width: 1279px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 1023px) {
    .intro-row {
      flex-direction: column;
    }
  }

  @media (max-width: 699px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .projects-shell {
      padding: var(--space-4) var(--space-3);
    }

    .project-search {
      width: 100%;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("#project-grid .card");
  const search = document.getElementById("project-search") as HTMLInputElement | null;
  const empty = document.getElementById("no-results");

  let activeFilter = "all";

  function apply() {
    const query = (search?.value ?? "").trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const cats = card.dataset.cats ?? "";
      const text = card.dataset.text ?? "";
      const show =
        (activeFilter === "all" || cats.includes(activeFilter)) &&
        (!query || text.includes(query));
      card.hidden = !show;
      if (show) visible++;
    });

    if (empty) empty.hidden = visible > 0;
  }

  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      activeFilter = chip.dataset.filter ?? "all";
      chips.forEach((other) => other.classList.toggle("active", other === chip));
      apply();
    }),
  );

  search?.addEventListener("input", apply);
</script>
