---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";
import MobileDrawer from "../components/MobileDrawer.astro";
import QuoteCard from "../components/QuoteCard.astro";
import Icon from "../components/Icon.astro";
import TechCard from "../components/TechCard.astro";
import { stack, totalTechnologies, mostUsed, workflow } from "../lib/stack";

const tocItems = [
  { id: "overview", title: "Overview" },
  ...stack.map((category) => ({ id: category.id, title: category.title })),
  { id: "workflow", title: "Workflow" },
];

let acc = 0;
const donutStops = mostUsed
  .map((slice) => {
    const from = acc;
    acc += slice.share;
    return `${slice.color} ${from}% ${acc}%`;
  })
  .join(", ");
---

<Base
  title="Tech Stack"
  description="A curated collection of technologies, frameworks and tools Andrei Ghiorghiu uses to design, build and scale modern applications."
>
  <Header />

  <div class="stack-shell">
    <div class="left-col">
      <details class="toc panel" id="stack-toc" open>
        <summary class="panel-title label">
          <Icon name="menu" size={13} /> On This Page
          <Icon name="chevron-down" size={14} class="toc-chevron" />
        </summary>
        <ul>
          {
            tocItems.map((item, index) => (
              <li>
                <a
                  href={`#${item.id}`}
                  class:list={["toc-link", { active: index === 0 }]}
                  data-stack-link={item.id}
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <div class="terminal-card">
        <div class="chrome" aria-hidden="true">
          <span class="chrome-controls">– ▢ ×</span>
        </div>
        <div class="terminal-body">
          <p><span class="ps">&gt; system@portfolio:~$</span> whoami</p>
          <p class="out">andreighiorghiu</p>
          <p><span class="ps">&gt; system@portfolio:~$</span> cat stack.conf</p>
          <p class="conf"><span class="key">passion</span> = building</p>
          <p class="conf"><span class="key">focus</span>   = architecture</p>
          <p class="conf"><span class="key">craft</span>   = scalable systems</p>
          <p class="conf"><span class="key">mission</span> = impact</p>
          <p><span class="ps">&gt; system@portfolio:~$</span> <span class="block-cursor"></span></p>
        </div>
      </div>

      <QuoteCard
        quote="The right technology is the one that solves today's problems without limiting tomorrow's possibilities."
        author="Andrei Ghiorghiu"
      />
    </div>

    <main id="overview">
      <p class="page-label label">/ Stack</p>

      <div class="intro-row">
        <div class="intro-text">
          <h1 class="cursor">Tech Stack</h1>
          <p class="lead">
            A curated collection of technologies, frameworks and tools I use to
            design, build and scale modern applications.
          </p>
        </div>
        <aside class="callout">
          <p><span class="chev">&gt;</span> Technology is just a tool.</p>
          <p><span class="chev">&gt;</span> Architecture is the craft.</p>
        </aside>
      </div>

      {
        stack.map((category) => (
          <section id={category.id} class="stack-section">
            <h2 class="section-title label">
              <Icon name={category.icon} size={15} />
              {category.title}
            </h2>
            <div class="cards">
              {category.items.map((tech) => (
                <TechCard {...tech} />
              ))}
            </div>
          </section>
        ))
      }

      <section id="workflow" class="stack-section">
        <h2 class="section-title label">
          <Icon name="cicd" size={15} />
          Workflow
        </h2>
        <div class="workflow-row">
          {
            workflow.map((step, index) => (
              <>
                <article class="workflow-card">
                  <span class="wf-icon">
                    <Icon name={step.icon} size={18} />
                  </span>
                  <h3 class="label">{step.title}</h3>
                  <p>{step.text}</p>
                </article>
                {index < workflow.length - 1 && (
                  <span class="wf-arrow" aria-hidden="true">
                    <Icon name="arrow-right" size={16} />
                  </span>
                )}
              </>
            ))
          }
        </div>
      </section>
    </main>

    <div class="rail-col">
      <div class="panel summary">
        <p class="panel-title label">Stack Summary</p>
        <ul>
          {
            stack.map((category) => (
              <li>
                <span>{category.title}</span>
                <span class="count">{category.items.length}</span>
              </li>
            ))
          }
          <li class="total">
            <span>Total Technologies</span>
            <span class="count">{totalTechnologies}</span>
          </li>
        </ul>
      </div>

      <div class="panel most-used">
        <p class="panel-title label">Most Used</p>
        <div class="donut" style={`background: conic-gradient(${donutStops});`}>
          <span class="donut-hole">Top<br />Technologies</span>
        </div>
        <ul class="legend">
          {
            mostUsed.map((slice) => (
              <li>
                <span class="dot" style={`background:${slice.color}`}></span>
                <span class="legend-name">{slice.name}</span>
                <span class="legend-share">{slice.share}%</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="panel workflow-panel">
        <p class="panel-title label">Workflow</p>
        <ol>
          {
            workflow.map((step, index) => (
              <li>
                <div class="step">
                  <span class="step-icon">
                    <Icon name={step.icon} size={15} />
                  </span>
                  <div>
                    <p class="step-title">{step.title}</p>
                    <p class="step-text">{step.text}</p>
                  </div>
                </div>
                {index < workflow.length - 1 && (
                  <span class="step-arrow" aria-hidden="true">
                    <Icon name="arrow-down" size={13} />
                  </span>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>

  <Footer />
  <SearchModal />
  <MobileDrawer
    items={tocItems.map((item) => ({ title: item.title, href: `#${item.id}` }))}
  />
</Base>

<style>
  .stack-shell {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr) 280px;
    gap: var(--space-4);
    align-items: start;
    max-width: 1560px;
    margin: 0 auto;
    padding: var(--space-4);
    min-height: calc(100vh - var(--header-h));
  }

  .left-col,
  .rail-col {
    position: sticky;
    top: calc(var(--header-h) + var(--space-4));
    max-height: calc(100vh - var(--header-h) - var(--space-4) * 2);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* ── left column ───────────────────────────────────── */
  .toc {
    padding: var(--space-3);
  }

  .panel-title {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    margin-bottom: var(--space-3);
  }

  summary.panel-title {
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  summary.panel-title::-webkit-details-marker {
    display: none;
  }

  .toc-chevron {
    margin-left: auto;
    color: var(--text-dim);
    transition: transform 0.2s ease;
  }

  .toc[open] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc:not([open]) summary.panel-title {
    margin-bottom: 0;
  }

  @media (min-width: 900px) {
    .toc-chevron {
      display: none;
    }

    summary.panel-title {
      pointer-events: none;
    }
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc-link {
    display: block;
    padding: 6px 10px;
    font-size: var(--fs-sm);
    color: var(--text-dim);
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .toc-link:hover {
    color: var(--text);
    background: var(--bg-hover);
  }

  .toc-link.active {
    color: var(--green);
    background: var(--bg-active);
    border-left-color: var(--green);
  }

  .terminal-card {
    border: var(--border-dim);
    border-radius: var(--radius-lg);
    background: var(--bg-panel);
    overflow: hidden;
  }

  .chrome {
    display: flex;
    justify-content: flex-end;
    padding: 6px 12px;
    border-bottom: var(--border-dim);
    color: var(--text-faint);
    font-size: var(--fs-xs);
    letter-spacing: 0.2em;
  }

  .terminal-body {
    padding: var(--space-3);
    font-size: var(--fs-xs);
    line-height: 2;
    white-space: pre-wrap;
  }

  .terminal-body p {
    margin: 0;
    color: var(--text);
  }

  .ps {
    color: var(--green);
  }

  .out {
    color: var(--text-dim);
    padding-left: 12px;
  }

  .conf .key {
    color: var(--green-dim);
  }

  .block-cursor {
    display: inline-block;
    width: 8px;
    height: 14px;
    background: var(--green);
    vertical-align: middle;
    animation: blink 1.1s steps(1) infinite;
  }

  /* ── main column ───────────────────────────────────── */
  .page-label {
    color: var(--green);
    margin-bottom: var(--space-3);
  }

  .intro-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: var(--fs-h1);
    margin-bottom: var(--space-3);
  }

  .lead {
    color: var(--text-dim);
    font-size: var(--fs-md);
    line-height: 1.75;
    max-width: 56ch;
  }

  .callout {
    flex-shrink: 0;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--bg-active);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
    color: var(--green);
    box-shadow: var(--glow);
  }

  .callout p {
    margin: 0;
    line-height: 1.9;
  }

  .chev {
    font-weight: 700;
  }

  .stack-section {
    margin-top: var(--space-5);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--green);
    font-size: var(--fs-sm);
    margin-bottom: var(--space-3);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--space-3);
  }

  /* ── workflow (main) ───────────────────────────────── */
  .workflow-row {
    display: flex;
    align-items: stretch;
    gap: var(--space-2);
  }

  .workflow-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: var(--space-3);
    border: var(--border-dim);
    border-radius: var(--radius-lg);
    background: var(--bg-panel);
  }

  .wf-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--green);
    border: var(--border-dim);
    border-radius: var(--radius);
    background: var(--bg-active);
  }

  .workflow-card h3 {
    color: var(--text-bright);
    font-size: var(--fs-xs);
  }

  .workflow-card p {
    color: var(--text-dim);
    font-size: var(--fs-xs);
    line-height: 1.6;
    margin: 0;
  }

  .wf-arrow {
    display: flex;
    align-items: center;
    color: var(--green-dim);
  }

  /* ── right rail ────────────────────────────────────── */
  .summary,
  .most-used,
  .workflow-panel {
    padding: var(--space-3);
  }

  .summary ul,
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .summary li {
    display: flex;
    justify-content: space-between;
    font-size: var(--fs-sm);
    color: var(--text-dim);
  }

  .summary .count {
    color: var(--green);
    font-weight: 700;
  }

  .summary .total {
    border-top: var(--border-dim);
    padding-top: 10px;
    margin-top: 4px;
    color: var(--text);
  }

  .donut {
    position: relative;
    width: 132px;
    height: 132px;
    border-radius: 50%;
    margin: var(--space-2) auto var(--space-3);
  }

  .donut-hole {
    position: absolute;
    inset: 18px;
    border-radius: 50%;
    background: var(--bg-panel);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--text-dim);
    font-size: var(--fs-2xs);
    line-height: 1.5;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-xs);
    color: var(--text-dim);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .legend-name {
    flex: 1;
  }

  .legend-share {
    color: var(--green);
  }

  .workflow-panel ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: var(--green);
    border: var(--border-dim);
    border-radius: var(--radius);
    background: var(--bg-active);
  }

  .step-title {
    color: var(--text);
    font-size: var(--fs-sm);
    font-weight: 700;
    margin: 0;
  }

  .step-text {
    color: var(--text-dim);
    font-size: var(--fs-xs);
    line-height: 1.5;
    margin: 2px 0 0;
  }

  .step-arrow {
    display: flex;
    padding: 6px 0 6px 8px;
    color: var(--green-dim);
  }

  /* ── responsive ────────────────────────────────────── */
  @media (max-width: 1279px) {
    .stack-shell {
      grid-template-columns: 232px minmax(0, 1fr);
    }

    .rail-col {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .stack-shell {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-3);
    }

    .left-col {
      position: static;
      max-height: none;
    }

    .terminal-card,
    .left-col :global(.quote-card) {
      display: none;
    }

    .intro-row {
      flex-direction: column;
    }

    .workflow-row {
      flex-direction: column;
    }

    .cards {
      grid-template-columns: 1fr;
    }

    .wf-arrow {
      justify-content: center;
    }

    .wf-arrow :global(svg) {
      transform: rotate(90deg);
    }
  }
</style>

<script>
  // start the "On This Page" panel collapsed on mobile
  const toc = document.getElementById("stack-toc") as HTMLDetailsElement | null;
  if (toc && window.matchMedia("(max-width: 899px)").matches) {
    toc.open = false;
  }

  const links = document.querySelectorAll<HTMLAnchorElement>("[data-stack-link]");

  if (links.length > 0) {
    const sections = [...links]
      .map((link) => document.getElementById(link.dataset.stackLink ?? ""))
      .filter((el): el is HTMLElement => el !== null);

    const pick = () => {
      let current = sections[0]?.id ?? "";
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= 120) current = section.id;
      }
      links.forEach((link) =>
        link.classList.toggle("active", link.dataset.stackLink === current),
      );
    };

    document.addEventListener("scroll", pick, { passive: true });
    pick();
  }
</script>
