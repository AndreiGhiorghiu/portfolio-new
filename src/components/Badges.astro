---
interface Props {
  badges: string[];
}

const { badges } = Astro.props;
---

<ul class="badges" role="list">
  {badges.map((badge) => <li class="label">{badge}</li>)}
</ul>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    color: var(--green);
    border: var(--border);
    border-radius: var(--radius);
    padding: 5px 12px;
    background: rgba(74, 222, 80, 0.04);
  }
</style>
