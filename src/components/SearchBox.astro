---
import Icon from "./Icon.astro";
---

<button class="search-box" data-search-open aria-label="Search documentation">
  <Icon name="search" size={15} />
  <span class="placeholder">Search docs...</span>
  <kbd>⌘K</kbd>
</button>

<style>
  .search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 9px 12px;
    background: var(--bg-panel);
    border: var(--border-dim);
    border-radius: var(--radius);
    color: var(--text-dim);
    font-size: var(--fs-sm);
    text-align: left;
  }

  .search-box:hover {
    border-color: var(--border-c);
    color: var(--text);
  }

  .placeholder {
    flex: 1;
  }

  kbd {
    font-family: var(--font);
    font-size: var(--fs-2xs);
    color: var(--text-faint);
    border: 1px solid rgba(125, 141, 129, 0.3);
    border-radius: 3px;
    padding: 1px 5px;
  }
</style>
