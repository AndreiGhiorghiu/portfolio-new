---
import Icon from "./Icon.astro";
---

<div class="arch-diagram dotted-bg">
  <div class="grid">
    <div class="node" style="grid-area: client">
      <span class="node-icon"><Icon name="monitor" size={20} /></span>
      <span class="node-title label">Client</span>
      <span class="node-sub accent">Web / SPA</span>
      <span class="node-sub">Vue / TypeScript</span>
    </div>

    <div class="arrow" style="grid-area: a1" aria-hidden="true">
      <svg viewBox="0 0 40 12" width="40" height="12">
        <line x1="0" y1="6" x2="30" y2="6"></line>
        <path d="M30 1.5 38 6 30 10.5Z"></path>
      </svg>
    </div>

    <div class="node" style="grid-area: gateway">
      <span class="node-icon"><Icon name="grid" size={20} /></span>
      <span class="node-title label">API Gateway</span>
      <span class="node-sub accent">Hono / Node.js</span>
      <span class="node-sub">POST /io</span>
    </div>

    <div class="arrow" style="grid-area: a2" aria-hidden="true">
      <svg viewBox="0 0 40 12" width="40" height="12">
        <line x1="0" y1="6" x2="30" y2="6"></line>
        <path d="M30 1.5 38 6 30 10.5Z"></path>
      </svg>
    </div>

    <div class="node services" style="grid-area: services">
      <span class="services-title label">Backend Services</span>
      <span class="hexagons">
        <span class="hex"><Icon name="hexagon-dot" size={22} /></span>
        <span class="hex"><Icon name="hexagon-dot" size={22} /></span>
        <span class="hex"><Icon name="hexagon-dot" size={22} /></span>
      </span>
      <span class="node-sub accent">Agent / Workers</span>
      <span class="node-sub">Typed operations</span>
    </div>

    <div class="arrow" style="grid-area: a3" aria-hidden="true">
      <svg viewBox="0 0 40 12" width="40" height="12">
        <line x1="0" y1="6" x2="30" y2="6"></line>
        <path d="M30 1.5 38 6 30 10.5Z"></path>
      </svg>
    </div>

    <div class="node" style="grid-area: data">
      <span class="node-icon"><Icon name="database" size={20} /></span>
      <span class="node-title label">Data Layer</span>
      <span class="node-sub accent">SQLite / Drizzle</span>
      <span class="node-sub">YAML rules</span>
    </div>

    <div class="arrow arrow-down" style="grid-area: a4" aria-hidden="true">
      <svg viewBox="0 0 12 40" width="12" height="40">
        <line x1="6" y1="0" x2="6" y2="30"></line>
        <path d="M1.5 30 6 38 10.5 30Z"></path>
      </svg>
    </div>

    <div class="node infra" style="grid-area: infra">
      <span class="node-icon"><Icon name="cloud" size={20} /></span>
      <span class="node-title label">Infrastructure</span>
      <span class="node-sub accent">Node.js / pnpm monorepo</span>
      <span class="node-sub">Docker / K8s ready</span>
    </div>
  </div>
</div>

<style>
  .arch-diagram {
    border: var(--border-dim);
    border-radius: var(--radius-lg);
    background: var(--bg-panel);
    padding: var(--space-5) var(--space-4);
    overflow-x: auto;
  }

  .grid {
    display: grid;
    grid-template-areas:
      "client a1 gateway a2 services a3 data"
      ".      .  .       .  a4       .  ."
      ".      .  infra   infra infra .  .";
    grid-template-columns: 1fr auto 1fr auto 1.15fr auto 1fr;
    align-items: center;
    justify-items: center;
    row-gap: 0;
    min-width: 640px;
    margin: 0 auto;
    max-width: 860px;
  }

  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    width: 100%;
    padding: var(--space-3) var(--space-2);
    background: rgba(5, 8, 7, 0.75);
    border: var(--border);
    border-radius: var(--radius);
    text-align: center;
  }

  .node-icon {
    display: flex;
    color: var(--green);
    margin-bottom: 6px;
  }

  .node-title {
    color: var(--text-bright);
    font-weight: 700;
  }

  .node-sub {
    font-size: var(--fs-2xs);
    color: var(--text-dim);
    line-height: 1.5;
  }

  .node-sub.accent {
    color: var(--green-dim);
  }

  .services {
    border-color: var(--green-faint);
    box-shadow: var(--glow);
  }

  .services-title {
    color: var(--green);
    font-weight: 700;
    margin-bottom: 8px;
  }

  .hexagons {
    display: flex;
    gap: 10px;
    color: var(--green);
    margin-bottom: 8px;
  }

  .arrow {
    display: flex;
    padding: 0 4px;
  }

  .arrow svg line {
    stroke: var(--green-dim);
    stroke-width: 1.5;
  }

  .arrow svg path {
    fill: var(--green-dim);
  }

  .arrow-down {
    padding: 2px 0;
  }

  @media (max-width: 767px) {
    .arch-diagram {
      padding: var(--space-4) var(--space-3);
      overflow-x: visible;
    }

    .grid {
      grid-template-areas:
        "client"
        "a1"
        "gateway"
        "a2"
        "services"
        "a3"
        "data"
        "a4"
        "infra";
      grid-template-columns: minmax(0, 260px);
      justify-content: center;
      min-width: 0;
    }

    .node {
      width: 100%;
    }

    .arrow svg {
      transform: rotate(90deg);
    }

    .arrow {
      padding: 8px 0;
      height: 40px;
      align-items: center;
      justify-content: center;
    }

    .arrow-down svg {
      transform: none;
    }
  }
</style>
