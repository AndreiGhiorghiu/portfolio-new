---

<div class="thumb dotted-bg" aria-hidden="true">
  <svg viewBox="0 0 400 186" preserveAspectRatio="xMidYMid meet">
    <defs>
      <marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="rgba(74,222,80,0.7)"></path>
      </marker>
    </defs>
    <g set:html={art[variant]} />
  </svg>
</div>

<style>
  .thumb {
    border-bottom: var(--border-dim);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background-color: rgba(5, 8, 7, 0.6);
    overflow: hidden;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  svg :global(rect),
  svg :global(circle),
  svg :global(ellipse),
  svg :global(line),
  svg :global(path) {
    fill: none;
    stroke: rgba(74, 222, 80, 0.55);
    stroke-width: 1.2;
  }

  svg :global(.dim line),
  svg :global(.dim rect),
  svg :global(.dim circle) {
    stroke: rgba(74, 222, 80, 0.28);
  }

  svg :global(.hl) {
    stroke: rgba(74, 222, 80, 0.9);
    filter: drop-shadow(0 0 3px rgba(74, 222, 80, 0.5));
  }

  svg :global(.node) {
    fill: rgba(74, 222, 80, 0.8);
    stroke: none;
  }

  svg :global(.node.hl2) {
    fill: #62f068;
    filter: drop-shadow(0 0 4px rgba(74, 222, 80, 0.8));
  }

  svg :global(text) {
    fill: rgba(201, 214, 204, 0.9);
    stroke: none;
    font-family: var(--font);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  svg :global(text.dim2) {
    fill: rgba(125, 141, 129, 0.9);
  }
</style>
