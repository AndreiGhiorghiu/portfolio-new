---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  title: string;
}

const { headings, title } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2);
---

<aside class="toc panel" data-toc>
  <p class="panel-title label">On This Page</p>
  <ul>
    <li>
      <a href="#top" class="toc-link active" data-toc-link="top">{title}</a>
    </li>
    {
      items.map((heading) => (
        <li>
          <a href={`#${heading.slug}`} class="toc-link" data-toc-link={heading.slug}>
            {heading.text}
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<style>
  .toc {
    padding: var(--space-3);
  }

  .panel-title {
    color: var(--text);
    margin-bottom: var(--space-3);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc-link {
    display: block;
    padding: 5px 8px;
    font-size: var(--fs-sm);
    color: var(--text-dim);
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius) var(--radius) 0;
    line-height: 1.45;
  }

  .toc-link:hover {
    color: var(--text);
    background: var(--bg-hover);
  }

  .toc-link.active {
    color: var(--green);
    background: var(--bg-active);
    border-left-color: var(--green);
  }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");

  if (links.length > 0) {
    const byId = new Map<string, HTMLAnchorElement>();
    links.forEach((link) => byId.set(link.dataset.tocLink ?? "", link));

    const headings = [...byId.keys()]
      .filter((id) => id !== "top")
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string) => {
      links.forEach((link) => link.classList.toggle("active", link.dataset.tocLink === id));
    };

    const pick = () => {
      const threshold = 110;
      let current = "top";
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= threshold) current = heading.id;
      }
      setActive(current);
    };

    document.addEventListener("scroll", pick, { passive: true });
    pick();
  }
</script>
