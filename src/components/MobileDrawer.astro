---
import Icon from "./Icon.astro";
import SidebarNav from "./SidebarNav.astro";

interface TocItem {
  title: string;
  href: string;
}

interface Props {
  currentSlug?: string;
  // per-page section links; when absent the docs sidebar is shown instead
  items?: TocItem[];
}

const { currentSlug, items } = Astro.props;
---

<div class="drawer-root" id="mobile-drawer" hidden>
  <div class="drawer-overlay" data-drawer-close></div>
  <aside class="drawer" aria-label="Navigation drawer">
    <div class="drawer-header">
      <span class="drawer-logo">AG<span class="accent">_</span></span>
      <button class="close" data-drawer-close aria-label="Close navigation">
        <Icon name="x" size={18} />
      </button>
    </div>
    <div class="drawer-nav">
      {
        items ? (
          <nav aria-label="On this page">
            <p class="label toc-title">On This Page</p>
            <ul class="toc-list">
              {items.map((item) => (
                <li>
                  <a href={item.href} class="toc-link">
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ) : (
          <SidebarNav currentSlug={currentSlug} />
        )
      }
    </div>
  </aside>
</div>

<style>
  .drawer-root {
    position: fixed;
    inset: 0;
    z-index: 90;
  }

  .drawer-overlay {
    position: absolute;
    inset: 0;
    background: rgba(2, 4, 3, 0.75);
  }

  .drawer {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: min(320px, 85vw);
    background: var(--bg);
    border-right: var(--border-dim);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: var(--space-3);
    gap: var(--space-3);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .drawer-logo {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-bright);
  }

  .accent {
    color: var(--green);
  }

  .close {
    color: var(--text-dim);
    padding: 6px;
  }

  .close:hover {
    color: var(--green);
  }

  .drawer-nav {
    flex: 1;
  }

  .toc-title {
    color: var(--text);
    padding: 8px 10px;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc-link {
    display: block;
    padding: 8px 10px;
    font-size: var(--fs-sm);
    color: var(--text-dim);
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .toc-link:hover {
    color: var(--text);
    background: var(--bg-hover);
  }
</style>

<script>
  const drawer = document.getElementById("mobile-drawer");

  function close() {
    if (!drawer) return;
    drawer.hidden = true;
    document.body.style.overflow = "";
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target.closest("#drawer-open") && drawer) {
      drawer.hidden = false;
      document.body.style.overflow = "hidden";
    }
    if (target.closest("[data-drawer-close]")) close();
    // tapping any drawer link (incl. same-page anchors) should dismiss it
    if (target.closest("#mobile-drawer a")) close();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && drawer && !drawer.hidden) close();
  });
</script>
