---
interface Props {
  name: string;
  size?: number;
}

const { name, size = 40 } = Astro.props;

type Badge = { kind: "badge"; bg: string; fg: string; text: string; fs?: number };
type Glyph = { kind: "glyph"; color: string; svg: string; fill?: boolean };

// prettier-ignore
const icons: Record<string, Badge | Glyph> = {
