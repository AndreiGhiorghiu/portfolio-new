  js:      { kind: "badge", bg: "#f7df1e", fg: "#111111", text: "JS" },
  php:     { kind: "badge", bg: "#777bb3", fg: "#ffffff", text: "php", fs: 11 },
  rust:    { kind: "badge", bg: "#1c1613", fg: "#f74c00", text: "R" },
  solid:   { kind: "badge", bg: "#101c2c", fg: "#75b2df", text: "S" },
  express: { kind: "badge", bg: "#161616", fg: "#e8e8e8", text: "ex", fs: 14 },
  laravel: { kind: "badge", bg: "#1c1010", fg: "#ff2d20", text: "L" },
  aws:     { kind: "badge", bg: "#191207", fg: "#ff9900", text: "aws", fs: 11 },
  nginx:   { kind: "badge", bg: "#0a1710", fg: "#009639", text: "N" },
  sentry:  { kind: "badge", bg: "#171224", fg: "#a48fdb", text: "S" },
  jest:    { kind: "badge", bg: "#1d0d0f", fg: "#c21325", text: "J" },
  cypress: { kind: "badge", bg: "#0d1815", fg: "#69d3a7", text: "Cy", fs: 13 },
  expo:    { kind: "badge", bg: "#111418", fg: "#dbe3ea", text: "Ex", fs: 13 },
  gsap:    { kind: "badge", bg: "#0d1810", fg: "#8ac640", text: "G" },
  notion:  { kind: "badge", bg: "#e8e8e8", fg: "#111111", text: "N" },
  three:   { kind: "glyph", color: "#e8e8e8", svg: '<path d="M12 2.5l8 4.6v9.3l-8 4.6-8-4.6V7.1z"/><path d="M4 7.1l8 4.6 8-4.6"/><line x1="12" y1="11.7" x2="12" y2="21"/>' },
  vite:    { kind: "glyph", color: "#9a7cff", fill: true, svg: '<polygon points="13 2 3 14 10.5 14 9.5 22 21 9 13.5 9"/>' },
  next:    { kind: "glyph", color: "#e8e8e8", svg: '<circle cx="12" cy="12" r="9.5"/><text x="12" y="16" text-anchor="middle" font-size="11" font-weight="700" font-family="inherit" fill="currentColor" stroke="none">N</text>' },
  wordpress:{ kind: "glyph", color: "#4b9fca", svg: '<circle cx="12" cy="12" r="9.5"/><text x="12" y="15.5" text-anchor="middle" font-size="10.5" font-weight="700" font-family="inherit" fill="currentColor" stroke="none">W</text>' },
  react:   { kind: "glyph", color: "#61dafb", svg: '<circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none"/><ellipse cx="12" cy="12" rx="10" ry="4"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/>' },
  electron:{ kind: "glyph", color: "#6cb6c4", svg: '<circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none"/><ellipse cx="12" cy="12" rx="10" ry="4"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/>' },
  vue:     { kind: "glyph", color: "#42b883", fill: true, svg: '<path d="M2 4h4.4L12 13.6 17.6 4H22L12 21z"/><path d="M7.5 4h3L12 6.7 13.5 4h3L12 11.8z" fill="#35495e"/>' },
  tailwind:{ kind: "glyph", color: "#38bdf8", fill: true, svg: '<path d="M12 6c-2.9 0-4.7 1.4-5.5 4.3.9-1.4 2.1-1.9 3.5-1.6.8.2 1.4.8 2 1.5.9 1.1 2.1 2.3 4.5 2.3 2.9 0 4.7-1.4 5.5-4.3-.9 1.4-2.1 1.9-3.5 1.6-.8-.2-1.4-.8-2-1.5C15.6 7.2 14.4 6 12 6zM6.5 12.5c-2.9 0-4.7 1.4-5.5 4.3.9-1.4 2.1-1.9 3.5-1.6.8.2 1.4.8 2 1.5.9 1.1 2.1 2.3 4.5 2.3 2.9 0 4.7-1.4 5.5-4.3-.9 1.4-2.1 1.9-3.5 1.6-.8-.2-1.4-.8-2-1.5-1-1.1-2.1-2.3-4.5-2.3z"/>' },
