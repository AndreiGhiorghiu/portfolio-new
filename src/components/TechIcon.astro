  hono:    { kind: "glyph", color: "#ff5b11", fill: true, svg: '<path d="M12 2c1 3-1.5 4.8-2.8 6.6C7.8 10.5 7 12.2 7 14a5 5 0 0 0 10 0c0-1.6-.6-3-1.5-4.4-.4 1-.9 1.7-1.8 2.3.3-2.6-.4-6.6-1.7-9.9z"/>' },
  graphql: { kind: "glyph", color: "#e10098", svg: '<path d="M12 3.6 19.3 7.8 19.3 16.2 12 20.4 4.7 16.2 4.7 7.8z"/><path d="M4.7 16.2 12 3.6 19.3 16.2z"/><circle cx="12" cy="3.6" r="1.6" fill="currentColor" stroke="none"/><circle cx="19.3" cy="7.8" r="1.6" fill="currentColor" stroke="none"/><circle cx="19.3" cy="16.2" r="1.6" fill="currentColor" stroke="none"/><circle cx="12" cy="20.4" r="1.6" fill="currentColor" stroke="none"/><circle cx="4.7" cy="16.2" r="1.6" fill="currentColor" stroke="none"/><circle cx="4.7" cy="7.8" r="1.6" fill="currentColor" stroke="none"/>' },
