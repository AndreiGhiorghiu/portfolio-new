  mysql:   { kind: "glyph", color: "#e48e00", svg: '<ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M20 5.5v13c0 1.66-3.58 3-8 3s-8-1.34-8-3v-13"/><path d="M20 12c0 1.66-3.58 3-8 3s-8-1.34-8-3"/>' },
  nosql:   { kind: "glyph", color: "#4ade50", svg: '<ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M20 5.5v13c0 1.66-3.58 3-8 3s-8-1.34-8-3v-13"/><path d="M20 12c0 1.66-3.58 3-8 3s-8-1.34-8-3"/>' },
  sql:     { kind: "glyph", color: "#b667e0", svg: '<ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M20 5.5v13c0 1.66-3.58 3-8 3s-8-1.34-8-3v-13"/><path d="M20 12c0 1.66-3.58 3-8 3s-8-1.34-8-3"/>' },
  docker:  { kind: "glyph", color: "#2496ed", svg: '<path d="M3 13h18c-.5 4-3.5 7-9 7s-8.5-3-9-7z"/><rect x="5" y="9.5" width="3" height="3"/><rect x="9" y="9.5" width="3" height="3"/><rect x="13" y="9.5" width="3" height="3"/><rect x="9" y="5.5" width="3" height="3"/>' },
  git:     { kind: "glyph", color: "#f05032", svg: '<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="12" r="2.5"/><line x1="6" y1="8.5" x2="6" y2="15.5"/><path d="M8 7.5c4 0 7.5 1 7.5 2.2"/>' },
  cicd:    { kind: "glyph", color: "#4ade50", svg: '<path d="M20 12a8 8 0 1 1-2.3-5.6"/><polyline points="17.8 2.6 17.8 6.6 13.8 6.6"/>' },
  state:   { kind: "glyph", color: "#a48fdb", svg: '<circle cx="6" cy="6" r="2.6"/><circle cx="18" cy="6" r="2.6"/><circle cx="12" cy="18" r="2.6"/><line x1="8.6" y1="6" x2="15.4" y2="6"/><line x1="7.2" y1="8.2" x2="10.8" y2="15.8"/><line x1="16.8" y1="8.2" x2="13.2" y2="15.8"/>' },
  websocket:{ kind: "glyph", color: "#4ade50", svg: '<path d="M3 8c2.5-3 6-4.5 9-4.5S18.5 5 21 8"/><path d="M6 11.5c1.8-2 4-3 6-3s4.2 1 6 3"/><circle cx="12" cy="16" r="2" fill="currentColor" stroke="none"/><line x1="12" y1="18" x2="12" y2="21"/>' },
  media:   { kind: "glyph", color: "#e5a44d", svg: '<rect x="3" y="5" width="18" height="14" rx="2"/><polygon points="10.5 9.5 15.5 12 10.5 14.5" fill="currentColor" stroke="none"/><line x1="3" y1="8" x2="6" y2="8"/><line x1="3" y1="16" x2="6" y2="16"/><line x1="18" y1="8" x2="21" y2="8"/><line x1="18" y1="16" x2="21" y2="16"/>' },
};

const icon = icons[name] ?? icons.ts;
const inner = Math.round(size * 0.6);
---

{
  icon.kind === "badge" ? (
    <span
      class="tech-icon badge"
      style={`--tile-bg:${icon.bg}; --tile-fg:${icon.fg}; width:${size}px; height:${size}px; font-size:${icon.fs ?? 15}px;`}
    >
      {icon.text}
    </span>
  ) : (
    <span class="tech-icon glyph" style={`--tile-fg:${icon.color}; width:${size}px; height:${size}px;`}>
      <svg
        width={inner}
        height={inner}
        viewBox="0 0 24 24"
        fill={icon.fill ? "currentColor" : "none"}
        stroke={icon.fill ? "none" : "currentColor"}
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={icon.svg}
      />
    </span>
  )
}

<style>
  .tech-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .badge {
    background: var(--tile-bg);
    color: var(--tile-fg);
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .glyph {
    background: #0d1310;
    border: 1px solid rgba(125, 141, 129, 0.18);
    color: var(--tile-fg);
  }
</style>
