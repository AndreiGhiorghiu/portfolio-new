---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import SidebarNav from "../components/SidebarNav.astro";
import SearchBox from "../components/SearchBox.astro";
import SearchModal from "../components/SearchModal.astro";
import MobileDrawer from "../components/MobileDrawer.astro";
import StatusWidget from "../components/StatusWidget.astro";
import QuoteCard from "../components/QuoteCard.astro";
import TechStackPanel from "../components/TechStackPanel.astro";
import Toc from "../components/Toc.astro";
import Badges from "../components/Badges.astro";
import PrevNext from "../components/PrevNext.astro";
import { groupOf } from "../lib/nav";

interface Props {
  entry: CollectionEntry<"docs">;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { title, description, badges, status } = entry.data;
const slug = entry.id;
const group = groupOf(slug);
---

<Base title={title} description={description}>
  <Header />

  <div class="docs-shell">
    <div class="sidebar-col">
      <div class="sidebar-search">
        <SearchBox />
      </div>
      <div class="sidebar-panel panel">
        <SidebarNav currentSlug={slug} />
      </div>
      <StatusWidget />
      <div class="sidebar-quote">
        <QuoteCard />
      </div>
    </div>

    <main class="content-col" id="top">
      <div class="mobile-search">
        <SearchBox />
      </div>
      <article class="doc-article panel">
        <p class="page-label label">
          <Icon name={group?.icon ?? "target"} size={14} />
          {group?.title ?? "Docs"}
        </p>

        {
          status === "proposed" && (
            <p class="proposed-banner label">
              <Icon name="zap" size={13} />
              Proposed adaptation — designed, not yet deployed
            </p>
          )
        }

        <h1 class="cursor">{title}</h1>
        <p class="lead">{description}</p>

        {badges && badges.length > 0 && <Badges badges={badges} />}

        <div class="article-body">
          <slot />
        </div>

        <PrevNext slug={slug} />
      </article>
    </main>

    <div class="rail-col">
      <Toc headings={headings} title={title} />
      <TechStackPanel />
      <QuoteCard />
    </div>
  </div>

  <Footer />
  <SearchModal />
  <MobileDrawer currentSlug={slug} />
</Base>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr) var(--rail-w);
    gap: var(--space-4);
    align-items: start;
    max-width: 1560px;
    margin: 0 auto;
    padding: var(--space-4);
    min-height: calc(100vh - var(--header-h));
  }

  .sidebar-col {
    position: sticky;
    top: calc(var(--header-h) + var(--space-4));
    max-height: calc(100vh - var(--header-h) - var(--space-4) * 2);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sidebar-search,
  .mobile-search {
    display: none;
  }

  .sidebar-panel {
    padding: var(--space-2);
  }

  .sidebar-quote {
    display: none;
  }

  .rail-col {
    position: sticky;
    top: calc(var(--header-h) + var(--space-4));
    max-height: calc(100vh - var(--header-h) - var(--space-4) * 2);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .doc-article {
    padding: var(--space-5);
  }

  .page-label {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--green);
    margin-bottom: var(--space-3);
  }

  .proposed-banner {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--amber);
    border: 1px solid rgba(229, 164, 77, 0.35);
    border-radius: var(--radius);
    background: rgba(229, 164, 77, 0.06);
    padding: 5px 12px;
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: var(--fs-h1);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  .lead {
    color: var(--text-dim);
    font-size: var(--fs-md);
    line-height: 1.75;
    max-width: 68ch;
    margin-bottom: var(--space-4);
  }

  /* ── article typography (targets rendered MDX) ─────── */
  .article-body {
    margin-top: var(--space-4);
  }

  .article-body :global(h2) {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-h2);
    margin: var(--space-5) 0 var(--space-3);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .article-body :global(h2::before) {
    content: "</>";
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--green);
    border: var(--border-dim);
    border-radius: var(--radius);
    background: var(--bg-active);
  }

  .article-body :global(h3) {
    font-size: var(--fs-lg);
    margin: var(--space-4) 0 var(--space-2);
    color: var(--text-bright);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .article-body :global(p) {
    margin: var(--space-3) 0;
    max-width: 76ch;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: var(--space-3) 0;
    padding-left: 1.4em;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .article-body :global(li)::marker {
    color: var(--green);
  }

  .article-body :global(strong) {
    color: var(--text-bright);
  }

  .article-body :global(blockquote) {
    border-left: 2px solid var(--green);
    background: var(--bg-active);
    padding: var(--space-3) var(--space-4);
    margin: var(--space-4) 0;
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text);
  }

  .article-body :global(blockquote p) {
    margin: 0;
  }

  .article-body :global(hr) {
    border: none;
    border-top: var(--border-dim);
    margin: var(--space-5) 0;
  }

  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-4) 0;
    font-size: var(--fs-sm);
  }

  .article-body :global(th) {
    text-align: left;
    color: var(--green);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
    border-bottom: var(--border);
    padding: 8px 12px;
  }

  .article-body :global(td) {
    border-bottom: var(--border-dim);
    padding: 8px 12px;
    color: var(--text);
    vertical-align: top;
  }

  .article-body :global(td code),
  .article-body :global(th code) {
    white-space: nowrap;
  }

  /* ── responsive ────────────────────────────────────── */
  @media (max-width: 1199px) {
    .docs-shell {
      grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
    }

    .rail-col {
      display: none;
    }

    .sidebar-search {
      display: block;
    }

    .sidebar-quote {
      display: block;
    }
  }

  @media (max-width: 767px) {
    .docs-shell {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-3);
    }

    .sidebar-col {
      display: none;
    }

    .mobile-search {
      display: block;
      margin-bottom: var(--space-3);
    }

    .doc-article {
      padding: var(--space-4) var(--space-3);
    }

    h1 {
      font-size: 1.55rem;
    }
  }
</style>
