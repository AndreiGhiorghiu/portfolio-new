---
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";
import MobileDrawer from "../components/MobileDrawer.astro";

interface Props {
  title: string;
  command: string;
  description: string;
}

const { title, command, description } = Astro.props;
---

<Base title={title} description={description}>
  <Header />

  <main class="stub-main">
    <div class="stub-card">
      <p class="stub-prompt">
        <span class="chevron">&gt;</span> {command}<span class="blink">_</span>
      </p>
      <h1 class="label">Under Construction</h1>
      <p class="stub-text">{description}</p>
      <a href="/docs/overview/high-level-overview/" class="stub-link label">
        &larr; Back to the architecture docs
      </a>
    </div>
  </main>

  <Footer />
  <SearchModal />
  <MobileDrawer />
</Base>

<style>
  .stub-main {
    min-height: calc(100vh - var(--header-h) - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-5) var(--space-3);
  }

  .stub-card {
    width: min(560px, 100%);
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-panel);
    box-shadow: var(--glow);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stub-prompt {
    color: var(--text);
    font-size: var(--fs-md);
  }

  .chevron {
    color: var(--green);
    font-weight: 700;
  }

  .blink {
    color: var(--green);
    animation: blink 1.1s steps(1) infinite;
  }

  h1 {
    color: var(--green);
    font-size: var(--fs-base);
    letter-spacing: var(--ls-wider);
  }

  .stub-text {
    color: var(--text-dim);
    font-size: var(--fs-sm);
    line-height: 1.7;
  }

  .stub-link {
    color: var(--green);
    margin-top: var(--space-2);
  }

  .stub-link:hover {
    color: var(--green-bright);
  }
</style>
